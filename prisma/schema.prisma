generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Size {
  PP
  P
  M
  G
  GG
}

enum ProductionMode {
  SOB_DEMANDA
  ESTOQUE
}

enum OrderStatus {
  RECEBIDO
  EM_PRODUCAO
  ENVIADO
  ENTREGUE
  CANCELADO
}

enum AdminRole {
  ADMIN
  OPERADOR
}

model Product {
  id          String           @id @default(cuid())
  name        String
  description String
  basePrice   Decimal          @db.Decimal(10, 2)
  images      String[]
  // Style/theme tags, used for "similar to what you bought" suggestions.
  tags        String[]
  variants    ProductVariant[]
  sizeChart   SizeChartEntry[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id                    String         @id @default(cuid())
  productId             String
  product               Product        @relation(fields: [productId], references: [id])
  size                  Size
  fit                   String
  color                 String
  fabric                String
  sku                   String         @unique
  stockOrProductionMode ProductionMode
  priceOverride         Decimal?       @db.Decimal(10, 2)
  orderItems            OrderItem[]
}

model Order {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     OrderStatus @default(RECEBIDO)
  createdAt  DateTime    @default(now())
  totalPrice Decimal     @db.Decimal(10, 2)
  items      OrderItem[]
}

model OrderItem {
  id                String         @id @default(cuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id])
  productVariantId  String
  productVariant    ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity          Int
  customizationData Json?
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  email       String
  phone       String
  street      String
  number      String
  complement  String?
  city        String
  state       String
  zipCode     String
  createdAt   DateTime     @default(now())
  orders      Order[]
  bodyProfile BodyProfile?
}

// Body measurements a customer saves in "Sobre mim", used to recommend sizes. All in cm (weight in kg).
model BodyProfile {
  id              String   @id @default(cuid())
  customerId      String   @unique
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Essential measurements
  heightCm        Decimal? @db.Decimal(5, 1)
  weightKg        Decimal? @db.Decimal(5, 1)
  bustCm          Decimal? @db.Decimal(5, 1)
  waistCm         Decimal? @db.Decimal(5, 1)
  hipCm           Decimal? @db.Decimal(5, 1)
  // Optional measurements that refine the recommendation
  shoulderWidthCm Decimal? @db.Decimal(5, 1)
  armLengthCm     Decimal? @db.Decimal(5, 1)
  torsoLengthCm   Decimal? @db.Decimal(5, 1)
  inseamCm        Decimal? @db.Decimal(5, 1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// A garment's real measurements for one size (flat, in cm), compared against the BodyProfile.
model SizeChartEntry {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size            Size
  chestWidthCm    Decimal  @db.Decimal(5, 1)
  lengthCm        Decimal  @db.Decimal(5, 1)
  shoulderWidthCm Decimal  @db.Decimal(5, 1)
  sleeveLengthCm  Decimal? @db.Decimal(5, 1)

  @@unique([productId, size])
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(OPERADOR)
}
